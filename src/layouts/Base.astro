---
import '../styles/global.css';
import geistFont from '../assets/fonts/Geist-Variable.woff2?url';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import { navItems, person, socialLinks } from '../data/portfolio';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  home?: boolean;
}

const { title, description, path = '', image = 'images/wisit-profile.jpg', home = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const built = new Date();
const year = built.getFullYear();
// Same short month style as the rest of the site ("Sep", not "Sept").
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const [bkkYear, bkkMonth, bkkDay] = built.toLocaleDateString('en-CA', { timeZone: 'Asia/Bangkok' }).split('-').map(Number);
const updated = bkkDay + ' ' + months[(bkkMonth ?? 1) - 1] + ' ' + bkkYear;
const canonical = person.siteUrl + path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={person.siteUrl + image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
      } catch (error) {}
    </script>
    <title>{title}</title>
  </head>
  <body class:list={[home ? 'page-home' : 'page-case']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="pointer-glow" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>
    <Nav home={home} />
    <slot />
    <a class="float-cta" href={'mailto:' + person.email} data-float-cta>
      <img class="float-cta__avatar" src={base + 'images/avatar.webp'} alt="" width="40" height="40" decoding="async" />
      <span class="float-cta__text"><strong>Email Wisit</strong><small><span class="availability__dot" aria-hidden="true"></span>Open to internships</small></span>
      <Icon name="arrow-up-right" />
    </a>
    <div class="toast" role="status" data-toast><span class="toast__label" data-toast-label></span><span class="toast__text" data-toast-text></span></div>
    <footer class="footer">
      <div class="footer__inner">
        <div class="footer__top">
          <div class="footer__about">
            <a class="footer__brand" href={home ? '#top' : base}>
              <img src={base + 'images/wisit-linkedin.webp'} alt="" width="48" height="48" loading="lazy" decoding="async" />
              <span><strong>{person.name}</strong><small>{person.nickname} · <span lang="th">{person.nicknameThai}</span></small></span>
            </a>
            <p class="footer__line">Computer Engineering student at KMUTT, building applied AI products and reproducible data pipelines.</p>
            <p class="footer__status"><span class="availability__dot" aria-hidden="true"></span>Open to AI engineering and data science internships</p>
            <ul class="socials" aria-label="Profiles">
              {socialLinks.map((social) => (
                <li><a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}><Icon name={social.icon} /></a></li>
              ))}
            </ul>
          </div>
          <nav class="footer__col" aria-label="Sections">
            <p class="footer__label">Sections</p>
            <ul>
              {navItems.map((item) => <li><a href={(home ? '' : base) + '#' + item.id}>{item.label}</a></li>)}
            </ul>
          </nav>
          <div class="footer__col">
            <p class="footer__label">Contact</p>
            <ul>
              <li><a href={'mailto:' + person.email}>{person.email}</a></li>
              <li><a href={person.cv} target="_blank" rel="noreferrer">CV on Google Drive</a></li>
              <li><span>Bangkok, Thailand</span></li>
            </ul>
          </div>
        </div>
        <div class="footer__bottom">
          <p class="meta-line">© {year} {person.name}. All rights reserved.</p>
          <p class="meta-line">Built with Astro, hosted on GitHub Pages. Updated {updated}.</p>
          <a class="text-link" href={home ? '#top' : base}>{home ? 'Back to top' : 'Back to home'}<Icon name="arrow-up-right" /></a>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/active-section.ts';
    </script>
  </body>
</html>
