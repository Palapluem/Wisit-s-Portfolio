---
import '../styles/global.css';
import geistFont from '../assets/fonts/Geist-Variable.woff2?url';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import { person, socialLinks } from '../data/portfolio';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  home?: boolean;
}

const { title, description, path = '', image = 'images/wisit-profile.jpg', home = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const canonical = person.siteUrl + path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={person.siteUrl + image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
      } catch (error) {}
    </script>
    <title>{title}</title>
  </head>
  <body class:list={[home ? 'page-home' : 'page-case']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="pointer-glow" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>
    <Nav home={home} />
    <slot />
    <a class="float-cta" href={'mailto:' + person.email} data-float-cta>
      <img class="float-cta__avatar" src={base + 'images/avatar.webp'} alt="" width="40" height="40" decoding="async" />
      <span class="float-cta__text"><strong>Email Wisit</strong><small><span class="availability__dot" aria-hidden="true"></span>Open to internships</small></span>
      <Icon name="arrow-up-right" />
    </a>
    <div class="toast" role="status" data-toast><span class="toast__label" data-toast-label></span><span class="toast__text" data-toast-text></span></div>
    <footer class="footer">
      <div class="footer__inner">
        <div class="footer__meta">
          <span class="meta-line">© {year} {person.name}</span>
          <ul class="socials" aria-label="Profiles">
            {socialLinks.map((social) => (
              <li><a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}><Icon name={social.icon} /></a></li>
            ))}
          </ul>
          <a class="text-link" href={home ? '#top' : base}>{home ? 'Back to top' : 'Back to home'}<Icon name="arrow-up-right" /></a>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/active-section.ts';
    </script>
  </body>
</html>
