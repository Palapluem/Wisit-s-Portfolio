---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const siteUrl = 'https://palapluem.github.io/Wisit-s-Portfolio/';
const year = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/Palapluem', icon: 'bxl-github' },
  { label: 'Instagram', href: 'https://instagram.com/ppalapluem', icon: 'bxl-instagram' },
  { label: 'Facebook', href: 'https://www.facebook.com/pluem.wisit.suwannao', icon: 'bxl-facebook' },
  { label: 'YouTube', href: 'https://www.youtube.com/@wisit-suwannao', icon: 'bxl-youtube' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/wisit-suwannao', icon: 'bxl-linkedin' },
];

const capabilityCards = [
  {
    title: 'Applied AI Engineering',
    icon: 'bx bx-brain',
    description: 'From source data and retrieval logic to evaluated model-assisted features, guarded APIs, and user-facing products.',
    tools: 'Python · PyTorch · FastAPI · Pydantic',
    image: base + 'images/cruit-app-career.png',
    alt: 'CRUiT career-path interface showing evidence-led vocational pathway selection',
    href: '#experience',
    linkText: 'Explore CRUiT',
  },
  {
    title: 'Data Science & Forecasting',
    icon: 'bx bx-line-chart',
    description: 'Exploratory analysis, leakage-aware feature design, model comparison, and evaluation across meaningful time horizons.',
    tools: 'PyTorch · Pandas · scikit-learn · PyCaret · AutoGluon',
    image: base + 'images/coffee-chain-winning-team.jpg',
    alt: 'The team receiving the Coffee Chain Demand Forecasting Hackathon winner board',
    href: '#achievements',
    linkText: 'See the forecasting win',
  },
  {
    title: 'Generative & Multimodal AI',
    icon: 'bx bx-layer',
    description: 'Building grounded workflows across Thai language, complex documents, images, and video, with evidence people can inspect.',
    tools: 'Thai NLP · Document AI · Vision · Audio',
    image: base + 'images/gemmaclip-cover.png',
    alt: 'GemmaClip evidence-first video-captioning project cover',
    href: '#achievements',
    linkText: 'Explore GemmaClip',
  },
  {
    title: 'Software & Data Workflows',
    icon: 'bx bx-code-alt',
    description: 'Connecting AI workflows to dependable services and interfaces through validation, testing, and maintainable system design.',
    tools: 'Next.js · TypeScript · Go / Chi · PostgreSQL · Docker Compose',
    image: base + 'images/twenty-constitutions-pipeline.webp',
    alt: 'Data-processing pipeline from 38 source PDFs through extraction, cleaning, and structure parsing to JSON and CSV',
    href: '#projects',
    linkText: 'View the CPE workflow',
  },
];

const programmingLanguages = ['Python', 'Java', 'C', 'C++', 'SQL', 'Go', 'TypeScript', 'JavaScript'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content="Wisit Suwannao is a KMUTT Computer Engineering student and AI Engineer with applied AI, data science, and software product experience." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Wisit Suwannao | AI & Data Science Portfolio" />
    <meta property="og:description" content="Applied AI, data science, engineering internships, competitions, and selected work by Wisit Suwannao." />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={siteUrl + 'images/wisit-profile.jpg'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="canonical" href={siteUrl} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" />
    <title>Wisit Suwannao | AI & Data Science Portfolio</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="header">
      <a href="#home" class="logo" aria-label="Wisit Suwannao, home">Wisit<span> SUWANNAO</span></a>
      <button class="menu-toggle" id="menu-icon" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
        <i class="bx bx-menu" aria-hidden="true"></i>
      </button>
      <nav class="navbar" id="primary-nav" aria-label="Main navigation">
        <a href="#home" class="nav-link">Home</a>
        <a href="#about" class="nav-link">Profile</a>
        <a href="#services" class="nav-link">Capabilities</a>
        <a href="#experience" class="nav-link">Experience</a>
        <a href="#projects" class="nav-link">Selected Work</a>
        <a href="#achievements" class="nav-link">Competitions</a>
        <a href="#education" class="nav-link">Education</a>
        <a href="#contact" class="nav-link">Contact</a>
      </nav>
      <a href="#contact" class="gradient-btn header-cta">Contact Me</a>
    </header>

    <main id="main">
      <section class="home" id="home" aria-labelledby="home-title">
        <div class="home-content" data-reveal>
          <p class="hero-kicker">COMPUTER ENGINEERING · KMUTT · BANGKOK, THAILAND</p>
          <h1 id="home-title">Wisit <span>Suwannao</span></h1>
          <h2 class="hero-role">I build <span>applied AI products</span></h2>
          <p>Computer Engineering student applying AI and data science to evaluated, evidence-grounded software products.</p>
          <div class="social-icons" aria-label="Social profiles">
            {socialLinks.map((social) => (
              <a href={social.href} title={social.label} aria-label={social.label} target="_blank" rel="noreferrer">
                <i class={'bx ' + social.icon} aria-hidden="true"></i>
              </a>
            ))}
          </div>
          <div class="btn-group">
            <a href="#projects" class="btn">Explore Selected Work</a>
            <a href="#contact" class="btn btn-outline">Let's Connect</a>
          </div>
          <div class="hero-highlights" aria-label="Selected achievements">
            <span><i class="bx bx-award" aria-hidden="true"></i>AI Engineer Award</span>
            <span><i class="bx bx-trophy" aria-hidden="true"></i>Coffee Chain Hackathon Winner</span>
            <span><i class="bx bx-medal" aria-hidden="true"></i>Gemma Prize · Track 2</span>
          </div>
        </div>
        <div class="home-img" data-reveal data-photo-carousel aria-roledescription="carousel" aria-label="Portfolio photos" style="--reveal-delay: 120ms">
          <div class="hero-photo-stack">
            <img class="hero-photo is-active" data-photo-slide data-photo-title="Wisit Suwannao" data-photo-subtitle="Computer Engineering · KMUTT" src={base + 'images/wisit-profile.jpg'} alt="Portrait of Wisit Suwannao" width="450" height="600" fetchpriority="high" />
            <img class="hero-photo" data-photo-slide data-photo-title="Coffee Chain Hackathon" data-photo-subtitle="Super AI Engineer Season 6 · Winning team" src={base + 'images/coffee-chain-winning-team.jpg'} alt="The Coffee Chain Demand Forecasting Hackathon winning team at Super AI Engineer Season 6" width="2048" height="1365" loading="lazy" aria-hidden="true" />
          </div>
          <div class="photo-controls" aria-label="Photo slideshow controls">
            <button class="photo-dot" type="button" data-photo-select="0" aria-label="Show portrait" aria-pressed="true"></button>
            <button class="photo-dot" type="button" data-photo-select="1" aria-label="Show hackathon team photo" aria-pressed="false"></button>
            <button class="photo-toggle" type="button" data-photo-toggle aria-label="Pause photo rotation"><i class="bx bx-pause" aria-hidden="true"></i></button>
          </div>
          <div class="photo-caption" aria-live="polite" aria-atomic="true"><span data-photo-title-display>Wisit Suwannao</span><span data-photo-subtitle-display>Computer Engineering · KMUTT</span></div>
        </div>
      </section>

      <section class="about section-alt" id="about" aria-labelledby="about-title">
        <div class="about-content" data-reveal style="--reveal-delay: 100ms">
          <p class="eyebrow">A LITTLE ABOUT HOW I WORK</p>
          <h2 class="heading" id="about-title">Curious about data.<br /><span>Focused on what ships.</span></h2>
          <p>I’m a Computer Engineering student at King Mongkut’s University of Technology Thonburi. My experience spans AI engineering internships, applied machine-learning programmes, and collaborative product competitions.</p>
          <p>I like the full problem-solving loop: understand the source data, make a method measurable, then turn the result into a product or API with clear evidence, sensible safeguards, and tests.</p>
          <div class="about-facts">
            <div><span>STUDYING</span><strong>B.Eng. Computer Engineering</strong></div>
            <div><span>FOCUS</span><strong>Applied AI · Data Science</strong></div>
            <div><span>BASED IN</span><strong>Bangkok, Thailand</strong></div>
          </div>
        </div>
        <aside class="profile-note" data-reveal aria-label="A snapshot of Wisit's project experience">
          <div class="profile-note-top"><span class="pulse-dot" aria-hidden="true"></span><span>HOW I APPROACH A PROBLEM</span></div>
          <div class="approach-step"><span>01</span><div><strong>Understand the evidence</strong><small>Inspect the data, document its limits, and define what a useful answer needs.</small></div></div>
          <div class="approach-step"><span>02</span><div><strong>Measure the method</strong><small>Choose suitable evaluation, test assumptions, and make trade-offs visible.</small></div></div>
          <div class="approach-step"><span>03</span><div><strong>Build for real use</strong><small>Connect models to APIs and interfaces with validation, guardrails, and tests.</small></div></div>
          <a class="text-link" href="#experience">See this in my internship work <span aria-hidden="true">↘</span></a>
        </aside>
      </section>

      <section class="services" id="services" aria-labelledby="services-heading">
        <div class="section-intro" data-reveal><p class="eyebrow">SKILLS & TECHNOLOGIES</p><h2 class="heading" id="services-heading">What I <span>Build</span></h2><p>My toolkit follows the work: analyze data, build and evaluate AI workflows, then deliver them through software people can use.</p></div>
        <div class="services-container">
          {capabilityCards.map((card, index) => (
            <article class="services-box" data-reveal style={'--reveal-delay:' + (index * 80) + 'ms'}>
              <figure class="service-media">
                <img class="service-image" src={card.image} alt={card.alt} width="1400" height="788" loading="lazy" />
              </figure>
              <div class="services-info">
                <i class={card.icon} aria-hidden="true"></i>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <p class="skill-tools">{card.tools}</p>
                <a class="capability-link" href={card.href}>{card.linkText} <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
        <div class="language-strip" data-reveal>
          <h3>Programming Languages</h3>
          <div class="language-chips">{programmingLanguages.map((language) => <span>{language}</span>)}</div>
        </div>
      </section>

      <section class="experience section-alt" id="experience" aria-labelledby="experience-title">
        <div class="section-intro" data-reveal><p class="eyebrow">INDUSTRY EXPERIENCE</p><h2 class="heading" id="experience-title">From <span>Research</span> to Product</h2><p>Two AI Engineering internships focused on evidence-grounded systems, document intelligence, and turning technical workflows into usable software.</p></div>
        <div class="experience-container">
          <article class="experience-card experience-feature" data-reveal>
            <div class="experience-copy">
              <div class="experience-meta"><span class="role-label">AI Engineer Intern</span><time>15 Jun - 30 Jul 2026</time></div>
              <h3>New Technology Information Co., Ltd. (NTi)</h3>
              <p class="experience-lead">Built <strong>CRUiT</strong>, an evidence-grounded career recommendation product that helps Thai vocational learners compare study and career pathways.</p>
              <ul class="detail-list">
                <li>Connected <strong>171 official OVEC programmes</strong> with labour-market evidence from the Department of Employment (DOE).</li>
                <li>Designed a six-stage workflow spanning profile validation, evidence retrieval, graph traversal, constrained pathway planning, and policy/claim checks.</li>
                <li>Returned source-backed pathway comparisons and practical <strong>30/60/90-day</strong> learning actions.</li>
              </ul>
              <div class="metric-ribbon" aria-label="CRUiT project scale"><div><strong>171</strong><span>official programmes</span></div><div><strong>6 stages</strong><span>evidence-to-plan flow</span></div><div><strong>30 / 60 / 90</strong><span>day learning actions</span></div></div>
              <details class="technical-details">
                <summary>Explore the engineering details</summary>
                <div class="details-body">
                  <p>A deterministic evidence engine establishes the recommended pathway; an optional language-model explanation layer communicates the validated result without changing its source-backed claims.</p>
                  <ul class="detail-list">
                    <li><strong>0.38 ms median</strong> for the deterministic evidence path across 30 local runs (not an external or production-scale benchmark).</li>
                    <li>Eight claim checks, fallback/abstention behavior, PII checks, and regression replay against 13 frozen answers.</li>
                    <li>Automated coverage included 200 API/backend, 27 unit, 15 browser, and 43 end-to-end cases; tested flows had zero serious/critical WCAG 2.1 AA violations.</li>
                  </ul>
                </div>
              </details>
              <div class="tag-list"><span>Python</span><span>FastAPI</span><span>Pydantic</span><span>Next.js</span><span>TypeScript</span><span>Automated testing</span></div>
            </div>
            <figure class="experience-visual cruit-visual">
              <div class="cruit-screens">
                <a class="cruit-desktop" href={base + 'images/cruit-app-career.png'} target="_blank" rel="noreferrer" aria-label="Open the CRUiT desktop interface screenshot">
                  <img src={base + 'images/cruit-app-career.png'} alt="CRUiT career-path interface showing evidence-led vocational pathway selection" width="1440" height="900" loading="lazy" />
                </a>
                <div class="cruit-mobile-frame">
                  <img src={base + 'images/cruit-app-career-mobile.png'} alt="CRUiT responsive mobile career-path interface" width="390" height="844" loading="lazy" />
                </div>
              </div>
              <figcaption><span>CRUiT · desktop and mobile product interface</span><a href={base + 'images/cruit-poster.png'} target="_blank" rel="noreferrer">Open technical poster <span aria-hidden="true">↗</span></a></figcaption>
            </figure>
          </article>
          <article class="experience-card" data-reveal>
            <div class="experience-meta"><span class="role-label">AI Engineer Intern</span><time>1 Mar - 3 May 2026</time></div>
            <h3>Oneput Technology Company Limited</h3>
            <p class="experience-lead">Developed a multimodal RAG workflow for <strong>ESG reports in PDF and Excel</strong>, handling complex layouts, charts, tables, and Thai text.</p>
            <ul class="detail-list">
              <li>Built asynchronous ingestion and hybrid retrieval that combined visual document retrieval with text search.</li>
              <li>Added a trust layer to validate quoted source text, Thai spans, amounts, units, reporting periods, evidence references, provenance, and superseded values before human confirmation/export.</li>
            </ul>
            <div class="workflow-visual">
              <p class="workflow-title"><i class="bx bx-git-branch" aria-hidden="true"></i> ESG document workflow</p>
              <ol class="workflow-flow" aria-label="Oneput internship workflow from source documents to reviewed evidence">
                <li><i class="bx bx-file" aria-hidden="true"></i><strong>PDF + Excel</strong><small>Reports with tables, charts, and Thai text</small></li>
                <li><i class="bx bx-transfer-alt" aria-hidden="true"></i><strong>Async ingestion</strong><small>Parsing, OCR, and layout-aware preparation</small></li>
                <li><i class="bx bx-search-alt" aria-hidden="true"></i><strong>Hybrid retrieval</strong><small>Visual document and text evidence</small></li>
                <li><i class="bx bx-check-shield" aria-hidden="true"></i><strong>Verify, review, export</strong><small>Check quotations, units, periods, and provenance</small></li>
              </ol>
            </div>
            <details class="technical-details">
              <summary>Explore the document pipeline</summary>
              <div class="details-body"><p>Document parsing and OCR feed a hybrid retrieval layer; retrieved evidence is checked by a Go/Chi service before a human reviews or exports the result. Retrieval uses ChromaDB with TF-IDF, fused through Reciprocal Rank Fusion (RRF).</p></div>
            </details>
            <div class="tag-list"><span>ColPali</span><span>Docling</span><span>Typhoon OCR 1.5</span><span>PyThaiNLP</span><span>FastAPI</span><span>ChromaDB</span><span>Go / Chi</span><span>PostgreSQL</span><span>MinIO</span><span>Docker Compose</span></div>
          </article>
        </div>
      </section>

      <section class="projects section-alt" id="projects" aria-labelledby="projects-title">
        <div class="section-intro" data-reveal><p class="eyebrow">SELECTED PROJECT · DATA MODELS</p><h2 class="heading" id="projects-title">Twenty Constitutions <span>Digitalization</span></h2><p>A document-engineering project that turns a large, inconsistent collection of Thai legal texts into structured, reusable data.</p></div>
        <article class="project-card" data-reveal>
          <a class="project-image" href="https://github.com/Palapluem/cpe232-datamodel-2025/blob/main/project/CPE232%20Presentation_Twenty%20Constitutions%20Digitalization.pdf" target="_blank" rel="noreferrer" aria-label="Open the Twenty Constitutions Digitalization presentation">
            <img src={base + 'images/twenty-constitutions-cover.png'} alt="Presentation cover for Twenty Constitutions Digitalization" width="1400" height="788" loading="lazy" />
          </a>
          <div class="project-copy">
            <p class="eyebrow">CPE232 DATA MODELS · APR - MAY 2026</p>
            <h3>From PDF archives to structured Thai text</h3>
            <p>Built an extraction and normalization workflow for <strong>20 Thai constitutions</strong> across <strong>38 PDF files</strong> and approximately <strong>61,000 words</strong>.</p>
            <ul class="detail-list">
              <li>Applied OCR to scanned documents and text extraction to digital PDFs.</li>
              <li>Normalized Thai Unicode and Buddhist Era dates, removed document noise, and structured chapter/article metadata.</li>
              <li>Validated JSON/CSV exports for exploratory analysis and downstream NLP.</li>
            </ul>
            <div class="tag-list"><span>Python</span><span>Jupyter</span><span>Typhoon OCR 1.5</span><span>PyMuPDF</span><span>pdfplumber</span><span>Pandas</span><span>PyThaiNLP</span><span>Attacut</span><span>scikit-learn</span></div>
            <a class="text-link" href="https://github.com/Palapluem/cpe232-datamodel-2025/blob/main/project/CPE232%20Presentation_Twenty%20Constitutions%20Digitalization.pdf" target="_blank" rel="noreferrer">Read the presentation <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <div class="project-evidence-grid" aria-label="Selected technical slides from the project presentation">
          <a class="project-evidence" href="https://github.com/Palapluem/cpe232-datamodel-2025/blob/main/project/CPE232%20Presentation_Twenty%20Constitutions%20Digitalization.pdf#page=18" target="_blank" rel="noreferrer">
            <img src={base + 'images/twenty-constitutions-final-datasets.webp'} alt="Presentation slide summarizing 38 documents, about 3,200 sections, 61,301 words, and structured JSON and CSV outputs" width="2200" height="1238" loading="lazy" />
            <span class="project-evidence-copy"><strong>Structured outputs</strong><small>38 documents · JSON hierarchy · section-level CSV</small></span>
          </a>
          <a class="project-evidence" href="https://github.com/Palapluem/cpe232-datamodel-2025/blob/main/project/CPE232%20Presentation_Twenty%20Constitutions%20Digitalization.pdf#page=28" target="_blank" rel="noreferrer">
            <img src={base + 'images/twenty-constitutions-topic-modeling.webp'} alt="Presentation slide showing the hybrid topic-modeling workflow with keyword and embedding-based scoring" width="2200" height="1238" loading="lazy" />
            <span class="project-evidence-copy"><strong>Hybrid topic modeling</strong><small>Keyword matching, embeddings, and semi-supervised topic discovery</small></span>
          </a>
        </div>
      </section>

      <section class="achievements" id="achievements" aria-labelledby="achievements-title">
        <div class="section-intro" data-reveal><p class="eyebrow">COMPETITIONS · RECOGNITION</p><h2 class="heading" id="achievements-title">Built, Tested, <span>Recognized</span></h2><p>Team competitions have been a practical way to work with real datasets, tight timelines, and measurable outcomes.</p></div>
        <div class="achievement-container">
          <article class="achievement-card competition-card" data-reveal>
            <figure class="achievement-image">
              <img src={base + 'images/coffee-chain-winning-team.jpg'} alt="Super AI Engineer Season 6 team holding the Coffee Chain Hackathon winner board" width="2048" height="1365" loading="lazy" />
            </figure>
            <div class="achievement-copy">
              <p class="eyebrow">HACKATHON WINNER · 12 - 15 MAY 2026</p>
              <h3>Super AI Engineer Season 6 Level 2:<br />Coffee Chain Demand Forecasting Hackathon</h3>
              <p>Our team won after building a forecasting approach around <strong>2,858,050 transactions</strong> and <strong>1,376,133 orders</strong> from 20 stores, 7 categories, and 670 days.</p>
              <p>We evaluated <strong>1-day, 7-day, and monthly horizons</strong> with MAE, accounting for seasonality, promotions, holidays/paydays, rainfall, stockouts, local events, and store capacity.</p>
              <div class="tag-list"><span>Time-series analysis</span><span>Feature engineering</span><span>MAE evaluation</span><span>Leakage-aware validation</span></div>
            </div>
          </article>

          <article class="achievement-card gemma-card" data-reveal style="--reveal-delay: 90ms">
            <div class="achievement-copy">
              <p class="eyebrow">AMD DEVELOPER HACKATHON: ACT II · 6 - 11 JUL 2026</p>
              <h3>GemmaClip: Evidence-First Video Captioning</h3>
              <p class="award-line">Google DeepMind Gemma Prize · Track 2 winner</p>
              <p>As an <strong>AI Engineer on team KMUTT Ma Laew</strong>, I helped build an evidence-first video-captioning system that makes the path from video to caption inspectable, not just a generated result.</p>
              <ul class="detail-list">
                <li>Selected six representative frames: four temporal anchors and two high-change moments.</li>
                <li>Used bounded audio context and an inspectable flow for frames, evidence, caption generation, and comparison.</li>
                <li>Won <strong>“Best Use of Gemma in Video Captioning”</strong> in Track 2.</li>
              </ul>
              <div class="link-row">
                <a class="text-link" href="https://lablab.ai/ai-hackathons/amd-developer-hackathon-act-ii/kmutt-ma-laew/gemmaclip" target="_blank" rel="noreferrer">Project page <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="https://github.com/ArmmyC/GemmaClip" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="https://storage.googleapis.com/lablab-static-eu/presentations/submissions/zmj1fpsmys7v3yx8dkiz16hd/zmj1fpsmys7v3yx8dkiz16hd-1783892405857_piid3sdb66w00ktwvbdq2nce.pdf" target="_blank" rel="noreferrer">Slides <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="https://www.facebook.com/share/p/1Du6rGh7Aa/" target="_blank" rel="noreferrer">Announcement <span aria-hidden="true">↗</span></a>
              </div>
            </div>
            <a class="gemma-image" href="https://lablab.ai/ai-hackathons/amd-developer-hackathon-act-ii/kmutt-ma-laew/gemmaclip" target="_blank" rel="noreferrer" aria-label="Open the GemmaClip hackathon project page">
              <img src={base + 'images/gemmaclip-cover.png'} alt="GemmaClip presentation cover for the AMD ACT II Hackathon" width="1400" height="788" loading="lazy" />
              <span>Open project <span aria-hidden="true">↗</span></span>
            </a>
          </article>

          <article class="season-panel" data-reveal>
            <div class="season-title">
              <p class="eyebrow">AI ENGINEER TRACK · 13 MAR - 3 SEP 2026</p>
              <h3>Super AI Engineer<br />Season 6</h3>
              <p>Progressed from baseline challenges to forecasting, then completed Level 3 through an NTi internship and the CRUiT product submission. Received the <strong>AI Engineer Award</strong> after Level 3.</p>
              <div class="season-award"><i class="bx bx-award" aria-hidden="true"></i><span><strong>AI Engineer Award</strong><small>Season 6 · Level 3 completion · 3 Sep 2026</small></span></div>
            </div>
            <ol class="level-list">
              <li><strong>Level 1 (13 Mar - 4 Apr 2026)</strong><p>Passed the Baseline Hackathon: Thai Election Results OCR, FahMai RAG, and five applied AI tasks across Thai NLP, image captioning, tabular prediction, house recognition, and sleep-stage classification.</p></li>
              <li><strong>Level 2 (8 May - 8 Jun 2026)</strong><p>Won the Coffee Chain Demand Forecasting Hackathon (12 - 15 May), working with 2.86M transactions across three forecast horizons.</p></li>
              <li><strong>Level 3 (15 Jun - 3 Sep 2026)</strong><p>AI Engineer internship at NTi and delivery of CRUiT as the programme product.</p></li>
            </ol>
          </article>

          <div class="achievement-notes" data-reveal>
            <article class="mini-achievement">
              <span class="highlight-year">2025</span>
