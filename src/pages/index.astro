---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import OrgMark from '../components/OrgMark.astro';
import StoryMosaic from '../components/StoryMosaic.astro';
import TechChip from '../components/TechChip.astro';
import WorkCard from '../components/WorkCard.astro';
import {
  capabilities,
  caseHref,
  competitions,
  credentials,
  highlightResults,
  languages,
  organisations,
  person,
  programmingLanguages,
  projects,
  socialLinks,
  srcsetFor,
  toolMarquee,
  workNumbers,
} from '../data/portfolio';

const base = import.meta.env.BASE_URL;
const linkedin = socialLinks.find((social) => social.label === 'LinkedIn');
const nti = { name: 'New Technology Information Co., Ltd. (NTi)', href: 'https://www.nti.co.th/', logo: 'logos/nti.png' };
const oneput = { name: 'Oneput Technology Company Limited', href: 'https://oneput.co/', logo: 'logos/oneput.png' };
---

<Base
  title="Wisit Suwannao | AI & Data Science Portfolio"
  description="Wisit Suwannao is a KMUTT Computer Engineering student and AI Engineer with applied AI, data science, and software product experience."
>
  <main id="main" tabindex="-1">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="guides" aria-hidden="true">
        <span class="guides__line guides__line--v guides__line--start"></span>
        <span class="guides__line guides__line--v guides__line--mid"></span>
        <span class="guides__line guides__line--v guides__line--end"></span>
        <span class="guides__line guides__line--h guides__line--top"></span>
        <span class="guides__line guides__line--h guides__line--bottom"></span>
        <span class="guides__ring guides__ring--a"></span>
        <span class="guides__ring guides__ring--b"></span>
      </div>
      <div class="hero__copy">
        <div class="intro enter" style="--i: 0">
          {linkedin ? (
            <a class="intro__photo" href={linkedin.href} target="_blank" rel="noreferrer" aria-label="Wisit Suwannao on LinkedIn">
              <img src={base + 'images/wisit-linkedin.webp'} alt="" width="200" height="200" decoding="async" />
              <span class="intro__badge" aria-hidden="true"><Icon name="linkedin-logo" /></span>
            </a>
          ) : (
            <span class="intro__photo"><img src={base + 'images/wisit-linkedin.webp'} alt="" width="200" height="200" decoding="async" /></span>
          )}
          <div class="intro__text">
            <p class="intro__hi">Hi, I’m {person.nickname} (<span lang="th">{person.nicknameThai}</span>)</p>
            <p class="intro__status"><span class="availability__dot" aria-hidden="true"></span>Open to AI engineering and data science internships</p>
          </div>
        </div>
        <h1 class="hero__title" id="hero-title"><span class="line"><span class="line__inner" style="--i: 1">Wisit</span></span> <span class="line"><span class="line__inner" style="--i: 2">Suwannao</span></span></h1>
        <p class="hero__lede enter" style="--i: 2">Computer Engineering student at KMUTT, building applied AI products and reproducible data pipelines.</p>
        <div class="hero__actions enter" style="--i: 3">
          <a class="button button--primary" href={'mailto:' + person.email}><Icon name="envelope-simple" />Email me</a>
          <a class="button button--quiet" href="#projects">See the work<Icon name="arrow-right" /></a>
          <a class="button button--quiet" href={person.cv} target="_blank" rel="noreferrer"><Icon name="file-text" />View CV<span class="sr-only"> (opens Google Drive)</span></a>
        </div>
      </div>
      <div class="hero__visual enter" style="--i: 2" data-tilt>
        <figure class="collage">
          <img class="collage__photo collage__photo--back" src={base + 'images/coffee-chain-winning-team.jpg'} srcset={srcsetFor(base, 'images/coffee-chain-winning-team.jpg')} sizes="(min-width: 64rem) 26rem, 80vw" alt="The Coffee Chain Demand Forecasting Hackathon winning team at Super AI Engineer Season 6" width="2048" height="1365" decoding="async" />
          <img class="collage__photo collage__photo--front" src={base + 'images/wisit-profile.jpg'} srcset={srcsetFor(base, 'images/wisit-profile.jpg')} sizes="(min-width: 64rem) 17rem, 52vw" alt="Portrait of Wisit Suwannao" width="450" height="600" fetchpriority="high" />
        </figure>
        <div class="ledger">
          <p class="ledger__label">Recent results</p>
          <ul class="ledger__list">
            {highlightResults.map((result) => (
              <li>
                <a href={caseHref(base, result.slug)}>
                  <span class="ledger__top"><span class="ledger__title">{result.title}</span><span class="ledger__date">{result.date}</span></span>
                  <span class="ledger__context">{result.context}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="numbers" aria-labelledby="numbers-title">
      <div class="shell">
        <h2 class="numbers__title" id="numbers-title">Numbers from the work</h2>
        <ul class="numbers__list" data-reveal-group>
          {workNumbers.map((item, index) => (
            <li class="number spot" data-reveal style={'--i: ' + index}>
              <a href={item.slug ? caseHref(base, item.slug) : item.href}>
                <span class="number__value" data-count={item.value} data-prefix={item.prefix} data-suffix={item.suffix}>{item.display}</span>
                <span class="number__label">{item.label}</span>
                <span class="number__source">{item.source}<Icon name="arrow-right" /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="org-band" aria-labelledby="orgs-title">
      <div class="shell org-band__head">
        <h2 class="org-band__title" id="orgs-title">Organisations along the way</h2>
        <p class="org-band__note">Internship hosts, university, programme organisers, and credential issuers.</p>
        <button class="marquee-toggle" type="button" data-marquee-toggle="orgs" aria-label="Pause the logo row">
          <Icon name="pause" class="marquee-toggle__pause" /><Icon name="play" class="marquee-toggle__play" />
        </button>
      </div>
      <Marquee label="Organisations" speed={36} class="marquee--logos" group="orgs">
        {organisations.map((org) => (
          <li class="logo-chip spot">
            <span class:list={['logo-chip__plate', org.wordmark && 'logo-chip__plate--wide']}><img src={base + org.logo} alt="" width="40" height="40" loading="lazy" decoding="async" /></span>
            <span class="logo-chip__name">{org.name}</span>
          </li>
        ))}
      </Marquee>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="shell about">
        <div class="about__main">
          <h2 class="section-title" id="about-title">About</h2>
          <p class="about__lead">I’m Wisit Suwannao (<span lang="th">วิศิษฐ์ สุวรรณเนาว์</span>), or Pluem (<span lang="th">ปลื้ม</span>), a Computer Engineering student at King Mongkut’s University of Technology Thonburi.</p>
          <p>My experience spans AI engineering internships, applied machine-learning programmes, and collaborative product competitions.</p>
          <p>I like the full problem-solving loop: understand the source data, make a method measurable, then turn the result into a product or API with clear evidence, sensible safeguards, and tests.</p>
          <a class="now beam" href={caseHref(base, 'thai-public-data-platform')}>
            <span class="now__label"><span class="availability__dot" aria-hidden="true"></span>Now building</span>
            <span class="now__title">Thai Public Data Platform</span>
            <span class="now__meta">Sep 2026 - Present, local-first data platform</span>
          </a>
        </div>
        <ol class="approach" aria-label="How I work">
          <li class="spot"><strong>Understand the evidence</strong><span>Inspect the data, document its limits, and define what a useful answer needs.</span></li>
          <li class="spot"><strong>Measure the method</strong><span>Choose suitable evaluation, test assumptions, and make trade-offs visible.</span></li>
          <li class="spot"><strong>Build for real use</strong><span>Connect models to APIs and interfaces with validation, guardrails, and tests.</span></li>
        </ol>
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-title">
      <div class="shell">
        <header class="section-head">
          <h2 class="section-title" id="experience-title">Experience</h2>
          <p class="section-lede">Two AI engineering internships focused on evidence-grounded systems, document intelligence, and turning technical workflows into usable software.</p>
        </header>
        <div class="roles">
          <article class="role" data-reveal>
            <header class="role__org">
              <OrgMark org={nti} />
              <div>
                <a class="role__org-name" href={nti.href} target="_blank" rel="noreferrer">NTi<Icon name="arrow-up-right" /></a>
                <p class="role__org-full">New Technology Information Co., Ltd.</p>
                <p class="meta-line"><time>15 Jun - 30 Jul 2026</time></p>
              </div>
            </header>
            <div class="role__body">
              <h3 class="role__title">AI Engineer Intern</h3>
              <p class="role__lead">Built <strong>CRUiT</strong>, an evidence-grounded career recommendation product that helps Thai vocational learners compare study and career pathways.</p>
              <ul class="chips" aria-label="Technologies">
                {['Python', 'FastAPI', 'Pydantic', 'Next.js', 'TypeScript', 'Automated testing'].map((tech) => <TechChip label={tech} />)}
              </ul>
              <ul class="bullets">
                <li>Connected <strong>171 official OVEC programmes</strong> with labour-market evidence from the Department of Employment (DOE).</li>
                <li>Designed a six-stage workflow spanning profile validation, evidence retrieval, graph traversal, constrained pathway planning, and policy/claim checks.</li>
                <li>Returned source-backed pathway comparisons and practical <strong>30/60/90-day</strong> learning actions.</li>
              </ul>
              <dl class="stat-strip" aria-label="CRUiT project scale">
                <div><dt>official programmes</dt><dd>171</dd></div>
                <div><dt>stages, evidence to plan</dt><dd>6</dd></div>
                <div><dt>day learning actions</dt><dd>30 / 60 / 90</dd></div>
              </dl>
              <figure class="shots">
                <a class="shots__desktop" href={base + 'images/cruit-app-career.png'} target="_blank" rel="noreferrer" aria-label="Open the CRUiT desktop interface screenshot">
                  <img src={base + 'images/cruit-app-career.png'} srcset={srcsetFor(base, 'images/cruit-app-career.png')} sizes="(min-width: 64rem) 42rem, 70vw" alt="CRUiT career-path interface showing evidence-led vocational pathway selection" width="1440" height="900" loading="lazy" decoding="async" />
                </a>
                <img class="shots__mobile" src={base + 'images/cruit-app-career-mobile.png'} srcset={srcsetFor(base, 'images/cruit-app-career-mobile.png')} sizes="(min-width: 64rem) 12rem, 26vw" alt="CRUiT responsive mobile career-path interface" width="390" height="844" loading="lazy" decoding="async" />
                <figcaption>
                  <span>CRUiT desktop and mobile interface</span>
                  <a class="text-link" href={base + 'images/cruit-poster.png'} target="_blank" rel="noreferrer">Technical poster<Icon name="arrow-up-right" /></a>
                </figcaption>
              </figure>
              <details class="disclosure">
                <summary>Engineering details<Icon name="x" /></summary>
                <div class="disclosure__body">
                  <p>A deterministic evidence engine establishes the recommended pathway; an optional language-model explanation layer communicates the validated result without changing its source-backed claims.</p>
                  <ul class="bullets">
                    <li><strong>0.38 ms median</strong> for the deterministic evidence path across 30 local runs (not an external or production-scale benchmark).</li>
                    <li>Eight claim checks, fallback/abstention behavior, PII checks, and regression replay against 13 frozen answers.</li>
                    <li>Automated coverage included 200 API/backend, 27 unit, 15 browser, and 43 end-to-end cases; tested flows had zero serious/critical WCAG 2.1 AA violations.</li>
                  </ul>
                </div>
              </details>
            </div>
          </article>

          <article class="role" data-reveal>
            <header class="role__org">
              <OrgMark org={oneput} />
              <div>
                <a class="role__org-name" href={oneput.href} target="_blank" rel="noreferrer">Oneput<Icon name="arrow-up-right" /></a>
                <p class="role__org-full">Oneput Technology Company Limited</p>
                <p class="meta-line"><time>1 Mar - 3 May 2026</time></p>
              </div>
            </header>
            <div class="role__body">
              <h3 class="role__title">AI Engineer Intern</h3>
              <p class="role__lead">Developed a multimodal RAG workflow for <strong>ESG reports in PDF and Excel</strong>, handling complex layouts, charts, tables, and Thai text.</p>
              <ul class="chips" aria-label="Technologies">
                {['ColPali', 'Docling', 'Typhoon OCR 1.5', 'PyThaiNLP', 'FastAPI', 'ChromaDB', 'Go / Chi', 'PostgreSQL', 'MinIO', 'Docker Compose'].map((tech) => <TechChip label={tech} />)}
              </ul>
              <ul class="bullets">
                <li>Built asynchronous ingestion and hybrid retrieval that combined visual document retrieval with text search.</li>
                <li>Added a trust layer to validate quoted source text, Thai spans, amounts, units, reporting periods, evidence references, provenance, and superseded values before human confirmation/export.</li>
              </ul>
              <ol class="flow" aria-label="ESG document workflow, from source documents to reviewed evidence">
                <li><strong>PDF + Excel</strong><span>Reports with tables, charts, and Thai text</span></li>
                <li><strong>Async ingestion</strong><span>Parsing, OCR, and layout-aware preparation</span></li>
                <li><strong>Hybrid retrieval</strong><span>Visual document and text evidence</span></li>
                <li><strong>Verify, review, export</strong><span>Check quotations, units, periods, and provenance</span></li>
              </ol>
              <details class="disclosure">
                <summary>Document pipeline<Icon name="x" /></summary>
                <div class="disclosure__body">
                  <p>Document parsing and OCR feed a hybrid retrieval layer; retrieved evidence is checked by a Go/Chi service before a human reviews or exports the result. Retrieval uses ChromaDB with TF-IDF, fused through Reciprocal Rank Fusion (RRF).</p>
                </div>
              </details>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="shell">
        <header class="section-head section-head--split">
          <div>
            <h2 class="section-title" id="projects-title">Selected work</h2>
            <p class="section-lede">Two data problems: dependable analytical pipelines, and complex Thai documents made usable. Each opens as a full case study.</p>
          </div>
          <a class="text-link" href="https://github.com/Palapluem" target="_blank" rel="noreferrer">More on GitHub<Icon name="arrow-up-right" /></a>
        </header>
        <div class="work-grid">
          {projects.map((study, index) => <WorkCard study={study} index={index} />)}
        </div>
      </div>
    </section>

    <section class="section" id="achievements" aria-labelledby="achievements-title">
      <div class="shell">
        <header class="section-head">
          <h2 class="section-title" id="achievements-title">Competitions</h2>
          <p class="section-lede">Hackathons and programme milestones. Each case covers the context, the result, and the technical breakdown.</p>
        </header>
        <StoryMosaic stories={competitions} label="Competitions and hackathons" />
      </div>
    </section>

    <section class="section" id="services" aria-labelledby="services-title">
      <div class="shell">
        <header class="section-head">
          <h2 class="section-title" id="services-title">Capabilities</h2>
          <p class="section-lede">Pick a capability to see where it shows up in the work.</p>
        </header>
        <div class="explorer" data-tabs>
          <div class="explorer__tabs" data-tablist aria-label="Capabilities">
            {capabilities.map((capability) => (
              <button class="explorer__tab" type="button" id={'tab-' + capability.id} data-tab={capability.id} aria-controls={'panel-' + capability.id}>
                {capability.title}
              </button>
            ))}
          </div>
          {capabilities.map((capability) => (
            <section class="explorer__panel spot" id={'panel-' + capability.id} data-panel={capability.id} aria-labelledby={'panel-title-' + capability.id}>
              <div class="explorer__intro">
                <h3 class="explorer__title" id={'panel-title-' + capability.id}>{capability.title}</h3>
                <p>{capability.description}</p>
                <ul class="chips" aria-label="Tools">{capability.tools.map((tool) => <TechChip label={tool} />)}</ul>
              </div>
              <div class="explorer__evidence">
                <p class="eyebrow-inline">Where it shows up</p>
                <ul class="evidence-links">
                  {capability.evidence.map((item) => (
                    <li>
                      <a class="spot" href={item.slug ? caseHref(base, item.slug) : item.href}>
                        <span class="evidence-links__label">{item.label}</span>
                        <span class="evidence-links__note">{item.note}</span>
                        <Icon name="arrow-right" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))}
        </div>
        <div class="stack beam">
          <div class="stack__head">
            <h3>Languages and tools</h3>
            <button class="marquee-toggle" type="button" data-marquee-toggle="stack" aria-label="Pause the language and tool rows">
              <Icon name="pause" class="marquee-toggle__pause" /><Icon name="play" class="marquee-toggle__play" />
            </button>
          </div>
          <Marquee label="Programming languages" speed={26} group="stack">{programmingLanguages.map((language) => <TechChip label={language} />)}</Marquee>
          <Marquee label="Tools used in the work" speed={30} reverse group="stack">{toolMarquee.map((tool) => <TechChip label={tool} />)}</Marquee>
        </div>
      </div>
    </section>

    <section class="section" id="credentials" aria-labelledby="credentials-title">
      <div class="shell">
        <header class="section-head">
          <h2 class="section-title" id="credentials-title">Credentials</h2>
          <p class="section-lede">Certifications and completion records, with continued learning on Google Cloud Skills Boost.</p>
        </header>
        <ul class="cred-list">
          {credentials.map((credential, index) => (
            <li class="cred spot" data-reveal style={'--i: ' + (index % 4)}>
              <OrgMark org={credential.org} size="sm" />
              <div class="cred__text">
                <p class="cred__name">{credential.name}</p>
                <p class="cred__issuer">{credential.issuer}</p>
                {credential.note && <p class="cred__note">{credential.note}</p>}
              </div>
              <p class="meta-line cred__date">{credential.datetime ? <time datetime={credential.datetime}>{credential.date}</time> : credential.date}</p>
            </li>
          ))}
        </ul>
        <div class="learning spot">
          <OrgMark org={{ name: 'Google Skills', logo: 'logos/google.svg' }} size="sm" />
          <p><strong>Google Cloud Skills Boost</strong>, badges and coursework: BigQuery, BigQuery ML, Cloud Run, Document AI, Vertex AI/MLOps, Vector Search/RAG, AI Agents.</p>
          <a class="text-link" href="https://www.skills.google/public_profiles/7a758760-9c99-4fad-9851-dd6cc083bbad" target="_blank" rel="noreferrer">View learning profile<Icon name="arrow-up-right" /></a>
        </div>
      </div>
    </section>

    <section class="section" id="education" aria-labelledby="education-title">
      <div class="shell education">
        <h2 class="section-title" id="education-title">Education</h2>
        <ul class="schools">
          <li class="school spot">
            <img src={base + 'logos/kmutt.webp'} alt="King Mongkut's University of Technology Thonburi logo" width="256" height="256" loading="lazy" decoding="async" />
            <div>
              <h3>Computer Engineering</h3>
              <p>King Mongkut's University of Technology Thonburi</p>
              <p class="meta-line">Aug 2024 - Present, GPAX 3.66 / 4.00</p>
            </div>
          </li>
          <li class="school spot">
            <img src={base + 'logos/kusk.webp'} alt="Kasetsart University Laboratory School logo" width="256" height="256" loading="lazy" decoding="async" />
            <div>
              <h3>Senior high school, SCiUS KU</h3>
              <p>Kasetsart University Laboratory School, Kamphaeng Saen Campus</p>
              <p class="meta-line">Jun 2021 - Apr 2024, GPAX 3.98 / 4.00</p>
            </div>
          </li>
        </ul>
        <div class="langs">
          <h3 class="langs__title">Languages</h3>
          <ul class="langs__list">
            {languages.map((language) => (
              <li class="lang spot">
                <span class="lang__hello" lang={language.code} aria-hidden="true">{language.hello}</span>
                <span class="lang__name">{language.name}</span>
                <span class="lang__level"><span class="lang__meter" data-level={language.level} aria-hidden="true"><i></i><i></i><i></i></span>{language.levelLabel}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--contact" id="contact" aria-labelledby="contact-title">
      <div class="shell contact">
        <div class="contact__intro">
          <h2 class="section-title" id="contact-title">Contact</h2>
          <p class="contact__statement">Open to AI engineering and data science internships.</p>
          <p class="contact__note">Also happy to talk about applied AI collaborations and technical work. Based in Bangkok, Thailand.</p>
          <div class="email-row">
            <a class="email-link" href={'mailto:' + person.email}>{person.email}</a>
            <button class="button button--quiet copy-button" type="button" data-copy-email={person.email}>
              <span data-copy-icon="copy"><Icon name="copy" /></span>
              <span data-copy-icon="done" hidden><Icon name="check" /></span>
              <span data-copy-label>Copy</span>
            </button>
            <a class="button button--quiet cv-button" href={person.cv} target="_blank" rel="noreferrer"><Icon name="file-text" />View CV<span class="sr-only"> (opens Google Drive)</span></a>
          </div>
          <ul class="channels">
            {socialLinks.map((social) => (
              <li><a href={social.href} target="_blank" rel="noreferrer"><Icon name={social.icon} />{social.label}<small>{social.handle}</small></a></li>
            ))}
          </ul>
        </div>
        <form class="contact-form spot" id="contact-form">
          <h3 class="contact-form__title">Write a message</h3>
          <div class="field">
            <label for="contact-name">Your name</label>
            <input type="text" id="contact-name" name="name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="contact-email">Your email</label>
            <input type="email" id="contact-email" name="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="contact-message">Your message</label>
            <textarea id="contact-message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="button button--primary">Open email draft</button>
          <p class="form-note" id="form-note" aria-live="polite">This opens your email app with a draft. It will not send until you choose to send it.</p>
        </form>
      </div>
    </section>
  </main>
</Base>
